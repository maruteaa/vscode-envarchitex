{
  "name": "envarchitex",
  "displayName": "EnvArchitex",
  "description": "AST-based detection of environment variables in JS/TS/Python/Rust/PHP/Go/Ruby/Java/C#/C++ with type inference and configurable auto-sync.",
  "version": "0.1.0",
  "publisher": "envarchitex",
  "license": "MIT",
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:python",
    "onLanguage:rust",
    "onLanguage:php",
    "onLanguage:go",
    "onLanguage:ruby",
    "onLanguage:java",
    "onLanguage:csharp",
    "onLanguage:c",
    "onLanguage:cpp",
    "workspaceContains:**/.env*",
    "workspaceContains:**/.env"
  ],
  "contributes": {
    "commands": [
      {
        "command": "envarchitex.syncEnvExample",
        "title": "EnvArchitex: Sync .env.example with detected variables"
      },
      {
        "command": "envarchitex.syncEnvFromExample",
        "title": "EnvArchitex: Sync .env with keys from .env.example"
      },
      {
        "command": "envarchitex.syncExampleFromEnv",
        "title": "EnvArchitex: Sync .env.example with keys from .env"
      },
      {
        "command": "envarchitex.scanWorkspace",
        "title": "EnvArchitex: Re-scan workspace"
      },
      {
        "command": "envarchitex.toggleSyncMode",
        "title": "EnvArchitex: Toggle auto/manual sync"
      },
      {
        "command": "envarchitex.openEnvExample",
        "title": "EnvArchitex: Open .env.example"
      },
      {
        "command": "envarchitex.showOutput",
        "title": "EnvArchitex: Show output channel"
      }
    ],
    "configuration": {
      "title": "EnvArchitex",
      "properties": {
        "envarchitex.syncMappings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "targets"
            ],
            "properties": {
              "source": {
                "type": "string",
                "description": "Source env file basename (e.g. '.env', '.env.production')."
              },
              "targets": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "description": "Target basenames to sync with (e.g. ['.env.example', '.env.sample'])."
              }
            }
          },
          "default": [
            {
              "source": ".env",
              "targets": [
                ".env.example"
              ]
            }
          ],
          "description": "Defines source environment files and target example/template files to synchronize."
        },
        "envarchitex.syncMode": {
          "type": "string",
          "enum": [
            "auto",
            "manual"
          ],
          "default": "auto",
          "description": "Controls when .env.example is synchronized from code references. 'auto' writes on save; 'manual' requires the command or a Quick Fix."
        },
        "envarchitex.syncEnvFromExample.mode": {
          "type": "string",
          "enum": [
            "auto",
            "manual"
          ],
          "default": "auto",
          "description": "Controls when .env is populated with missing keys from .env.example. 'auto' syncs on .env.example save and after the example itself is updated; 'manual' requires the command."
        },
        "envarchitex.syncExampleFromEnv.mode": {
          "type": "string",
          "enum": [
            "auto",
            "manual"
          ],
          "default": "auto",
          "description": "Controls when .env.example is populated with missing keys from .env. 'auto' mirrors keys on .env save; 'manual' requires the command. Values are NEVER copied — only key names. Note that .env.example is typically committed, so any key names you add to .env will appear in source control."
        },
        "envarchitex.diagnostics.envExample": {
          "type": "string",
          "enum": [
            "warning",
            "off"
          ],
          "default": "warning",
          "description": "Severity of diagnostics for variables missing from .env.example."
        },
        "envarchitex.diagnostics.envLocal": {
          "type": "string",
          "enum": [
            "info",
            "off"
          ],
          "default": "info",
          "description": "Severity of diagnostics for variables missing from .env."
        },
        "envarchitex.languages.enabled": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "javascript",
            "javascriptreact",
            "typescript",
            "typescriptreact",
            "python",
            "rust",
            "php",
            "go",
            "ruby",
            "java",
            "csharp",
            "c",
            "cpp"
          ],
          "description": "Languages EnvArchitex will scan."
        },
        "envarchitex.typeInference.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Infer variable types (string/number/boolean) from usage context."
        },
        "envarchitex.typeInference.emitTypeComment": {
          "type": "boolean",
          "default": true,
          "description": "When syncing .env.example, append a '# type: <type>' inline comment for non-string values."
        },
        "envarchitex.notifications.onSync": {
          "type": "string",
          "enum": [
            "always",
            "summary",
            "off"
          ],
          "default": "always",
          "description": "When to notify the user after a successful sync."
        },
        "envarchitex.ignore.globs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.venv/**",
            "**/dist/**",
            "**/build/**",
            "**/out/**",
            "**/target/**",
            "**/vendor/**",
            "**/.gradle/**",
            "**/bin/**",
            "**/obj/**"
          ],
          "description": "Glob patterns to skip during scans."
        },
        "envarchitex.maxFileBytes": {
          "type": "number",
          "default": 1048576,
          "description": "Files larger than this many bytes are skipped."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "web-tree-sitter": "^0.26.8"
  },
  "devDependencies": {
    "@types/emscripten": "^1.39.13",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.116.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "esbuild": "^0.27.7",
    "eslint": "^9.18.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.20.0"
  }
}